#===============================================================================
# User Options
#===============================================================================

# ROCm clang OpenMP offload (AOMP-style flags). Default ISA is MI300A.
ROCM      ?= /opt/rocm
CC        = $(ROCM)/llvm/bin/clang++
OPTIMIZE  = yes
DEBUG     = no
DEVICE    = gpu
ARCH      ?= gfx942
LAUNCHER  ?=

# One zone per resident full block. Each launch runs STEPS backward-Euler
# steps. WARMUP is the untimed full launch count, ITERS the timed one.
STEPS  ?= 100
WARMUP ?= 5
ITERS  ?= 10

#===============================================================================
# Program name & source code list
#===============================================================================

program = main

source = main.cpp

obj = $(source:.cpp=.o)

#===============================================================================
# Sets Flags
#===============================================================================

CFLAGS := $(EXTRA_CFLAGS) -std=c++17 -Wall -DSTIFF_ODE_HAS_HSA -I$(ROCM)/include

LDFLAGS = -L$(ROCM)/lib -lhsa-runtime64 -Wl,-rpath,$(ROCM)/lib -Wl,-rpath,$(ROCM)/llvm/lib

ifeq ($(DEBUG),yes)
  CFLAGS += -g
  LDFLAGS += -g
endif

ifeq ($(OPTIMIZE),yes)
  CFLAGS += -O3
endif

ifeq ($(DEVICE),gpu)
  CFLAGS += -fopenmp -fopenmp-targets=amdgcn-amd-amdhsa \
            -Xopenmp-target=amdgcn-amd-amdhsa -march=$(ARCH)
else
  CFLAGS += -fopenmp
endif

#===============================================================================
# Targets to Build
#===============================================================================

$(program): $(obj) Makefile.aomp
	$(CC) $(CFLAGS) $(obj) -o $@ $(LDFLAGS)

%.o: %.cpp kinetics.h ../stiff-ode-cuda/mechanism.h \
           ../stiff-ode-cuda/workload.h ../stiff-ode-cuda/reference.h Makefile.aomp
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(program) $(obj)

run: $(program)
	$(LAUNCHER) ./$(program) --iters $(ITERS) --steps $(STEPS) --warmup $(WARMUP)

.PHONY: clean run
