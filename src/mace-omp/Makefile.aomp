#===============================================================================
# User Options
#===============================================================================

# ROCm OpenMP GPU offload with rocBLAS (amdclang++ or ROCm clang++).
# CPU (DEVICE=cpu) is unsupported.
CC        = clang++
OPTIMIZE  = yes
DEBUG     = no
DEVICE    = gpu
ARCH      ?= gfx908
ROCM      ?= /opt/rocm
LAUNCHER  ?=
FIXTURE   ?= ../data/hydragnn-sc26/mace_pipeline_capture.macepipe

#===============================================================================
# Program name & source code list
#===============================================================================

program = main

source = main.cpp

obj = $(source:.cpp=.o)

#===============================================================================
# Sets Flags
#===============================================================================

# Standard Flags
CFLAGS := $(EXTRA_CFLAGS) -std=c++17 -Wall -DMACE_OMP_ROCBLAS \
          -D__HIP_PLATFORM_AMD__ -isystem $(ROCM)/include

# Linker Flags
LDFLAGS = -L$(ROCM)/lib -lrocblas -lamdhip64 \
          -Wl,-rpath,$(ROCM)/lib -Wl,-rpath,$(ROCM)/llvm/lib \
          -Wl,-rpath,$(ROCM)/lib/llvm/lib

# Debug Flags
ifeq ($(DEBUG),yes)
  CFLAGS  += -g -DDEBUG
  LDFLAGS += -g
endif

# Optimization Flags
ifeq ($(OPTIMIZE),yes)
  CFLAGS += -O3
endif

ifneq ($(DEVICE),gpu)
  $(error mace-omp requires DEVICE=gpu; CPU is unsupported)
endif

CFLAGS += -target x86_64-pc-linux-gnu \
          -fopenmp -fopenmp-targets=amdgcn-amd-amdhsa \
          -Xopenmp-target=amdgcn-amd-amdhsa \
          -march=$(ARCH)

#===============================================================================
# Targets to Build
#===============================================================================

$(program): $(obj) Makefile.aomp
	$(CC) $(CFLAGS) $(obj) -o $@ $(LDFLAGS)

%.o: %.cpp mace_pipeline.hpp mace_nlist.hpp Makefile.aomp
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(program) $(obj)

# The timed workload is a synthetic batch at the published SC26 dimensions:
# 128 graphs, 2726 atoms, 45974 edges. Correctness is validated on the captured
# fixture first. Default GEMM is rocBLAS rocblas_sgemm.
run: $(program)
	$(LAUNCHER) ./$(program) --fixture $(FIXTURE) --gemm blas \
	  --warmup 100 --repeat 100
